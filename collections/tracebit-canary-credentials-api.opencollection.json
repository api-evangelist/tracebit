{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tracebit Alerts Canary Credentials API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Canary Credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Issue credentials",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://community.tracebit.com/api/v1/credentials/issue-credentials",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Issue canary credentials of the requested types. The credentials should be confirmed via the /confirm-credentials endpoint after their appropriate deployment.\n\nRequired permission: `canary-credentials:all:create`."
        },
        {
          "info": {
            "name": "Confirm credentials deployment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://community.tracebit.com/api/v1/credentials/confirm-credentials",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Confirm the successful deployment of canary credentials. Should be called with the confirmationId of the credentials issued via the /issue-credentials endpoint.\n\nRequired permission: `canary-credentials:all:create`."
        }
      ]
    }
  ],
  "bundled": true
}